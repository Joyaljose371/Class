rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Read-only portal records for the student verified in this anonymous session.
    match /studentPortals/{portalId} {
      allow get: if isClassAdmin() || isSelectedStudent(portalId);
      allow list: if false;
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if request.auth != null
                            && resource.data.ownerUid == request.auth.uid;
    }

    // Public read-only directory used by the single shared student page.
    match /studentPortalDirectory/{docId} {
      allow get: if docId == "current";
      allow list: if false;
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if request.auth != null
                            && resource.data.ownerUid == request.auth.uid;
    }


    // Legacy access-code documents remain admin-only while old records are removed.
    match /studentPortalSecrets/{portalId} {
      allow read, write: if isClassAdmin();
    }

    // A student session is created only when the submitted registration number matches the portal record.
    match /studentSessions/{userId} {
      allow read: if request.auth != null
                  && request.auth.uid == userId;

      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['ownerUid', 'portalId', 'regNo', 'selectedAtMs'])
        && request.resource.data.keys().hasAll(['ownerUid', 'portalId', 'regNo', 'selectedAtMs'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.portalId is string
        && request.resource.data.regNo is string
        && request.resource.data.regNo.size() > 0
        && request.resource.data.selectedAtMs is int
        && exists(/databases/$(database)/documents/studentPortals/$(request.resource.data.portalId))
        && get(/databases/$(database)/documents/studentPortals/$(request.resource.data.portalId)).data.regNo is string
        && request.resource.data.regNo == get(/databases/$(database)/documents/studentPortals/$(request.resource.data.portalId)).data.regNo;

      allow delete: if request.auth != null
                    && (request.auth.uid == userId || isClassAdmin());
    }

    function hasSelectedStudentSession() {
      return request.auth != null
        && exists(/databases/$(database)/documents/studentSessions/$(request.auth.uid))
        && get(/databases/$(database)/documents/studentSessions/$(request.auth.uid)).data.portalId is string
        && isSelectedStudent(get(/databases/$(database)/documents/studentSessions/$(request.auth.uid)).data.portalId);
    }

    function selectedStudentPortalId() {
      return get(/databases/$(database)/documents/studentSessions/$(request.auth.uid)).data.portalId;
    }

    // Topic locks are transaction-bound; assignment records are listable only by the admin.
    match /assignmentTopicPools/{poolId} {
      allow get: if poolId == "current" && (isClassAdmin() || hasSelectedStudentSession());
      allow list: if false;
      allow create, update: if poolId == "current"
        && isClassAdmin()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.roundId is string
        && request.resource.data.topicIds is list
        && request.resource.data.topicIds.size() <= 300
        && request.resource.data.topicTitles is map
        && existsAfter(/databases/$(database)/documents/assignmentTopicPools/current/rounds/$(request.resource.data.roundId))
        && getAfter(/databases/$(database)/documents/assignmentTopicPools/current/rounds/$(request.resource.data.roundId)).data.ownerUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/assignmentTopicPools/current/rounds/$(request.resource.data.roundId)).data.topicIds == request.resource.data.topicIds
        && getAfter(/databases/$(database)/documents/assignmentTopicPools/current/rounds/$(request.resource.data.roundId)).data.topicTitles == request.resource.data.topicTitles;
      allow delete: if false;

      match /rounds/{roundId} {
        allow get: if isClassAdmin()
          || (hasSelectedStudentSession()
            && get(/databases/$(database)/documents/assignmentTopicPools/current).data.roundId == roundId);
        allow list: if isClassAdmin();
        allow create: if isClassAdmin()
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.roundId == roundId
          && request.resource.data.topicIds is list
          && request.resource.data.topicIds.size() <= 300
          && request.resource.data.topicTitles is map
          && existsAfter(/databases/$(database)/documents/assignmentTopicPools/current)
          && getAfter(/databases/$(database)/documents/assignmentTopicPools/current).data.roundId == roundId;
        allow update, delete: if false;

        match /locks/{topicId} {
          allow get: if isClassAdmin()
            || (hasSelectedStudentSession()
              && get(/databases/$(database)/documents/assignmentTopicPools/current).data.roundId == roundId);
          allow list: if false;
          allow create: if hasSelectedStudentSession()
            && request.resource.data.keys().hasOnly(['roundId', 'topicId'])
            && request.resource.data.roundId == roundId
            && request.resource.data.topicId == topicId
            && get(/databases/$(database)/documents/assignmentTopicPools/current).data.roundId == roundId
            && get(/databases/$(database)/documents/assignmentTopicPools/current/rounds/$(roundId)).data.topicIds.hasAny([topicId])
            && !exists(/databases/$(database)/documents/assignmentTopicPools/current/rounds/$(roundId)/draws/$(selectedStudentPortalId()))
            && existsAfter(/databases/$(database)/documents/assignmentTopicPools/current/rounds/$(roundId)/draws/$(selectedStudentPortalId()))
            && getAfter(/databases/$(database)/documents/assignmentTopicPools/current/rounds/$(roundId)/draws/$(selectedStudentPortalId())).data.topicId == topicId;
          allow update, delete: if false;
        }

        match /draws/{portalId} {
          allow get: if isClassAdmin() || isSelectedStudent(portalId);
          allow list: if isClassAdmin();
          allow create: if isSelectedStudent(portalId)
            && request.resource.data.keys().hasOnly(['ownerUid', 'portalId', 'roundId', 'topicId', 'topic', 'studentName', 'regNo', 'drawnAtMs'])
            && request.resource.data.keys().hasAll(['ownerUid', 'portalId', 'roundId', 'topicId', 'topic', 'studentName', 'regNo', 'drawnAtMs'])
            && request.resource.data.ownerUid == request.auth.uid
            && request.resource.data.portalId == portalId
            && request.resource.data.roundId == roundId
            && request.resource.data.topicId is string
            && request.resource.data.topic is string
            && request.resource.data.studentName is string
            && request.resource.data.regNo is string
            && request.resource.data.drawnAtMs is int
            && get(/databases/$(database)/documents/assignmentTopicPools/current).data.roundId == roundId
            && get(/databases/$(database)/documents/assignmentTopicPools/current/rounds/$(roundId)).data.topicIds.hasAny([request.resource.data.topicId])
            && get(/databases/$(database)/documents/assignmentTopicPools/current/rounds/$(roundId)).data.topicTitles[request.resource.data.topicId] == request.resource.data.topic
            && get(/databases/$(database)/documents/studentPortals/$(portalId)).data.studentName == request.resource.data.studentName
            && get(/databases/$(database)/documents/studentPortals/$(portalId)).data.regNo == request.resource.data.regNo
            && !exists(/databases/$(database)/documents/assignmentTopicPools/current/rounds/$(roundId)/locks/$(request.resource.data.topicId))
            && existsAfter(/databases/$(database)/documents/assignmentTopicPools/current/rounds/$(roundId)/locks/$(request.resource.data.topicId))
            && getAfter(/databases/$(database)/documents/assignmentTopicPools/current/rounds/$(roundId)/locks/$(request.resource.data.topicId)).data.roundId == roundId
            && getAfter(/databases/$(database)/documents/assignmentTopicPools/current/rounds/$(roundId)/locks/$(request.resource.data.topicId)).data.topicId == request.resource.data.topicId;
          allow update, delete: if false;
        }
      }
    }

    function isClassAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/studentPortalDirectory/current).data.ownerUid == request.auth.uid;
    }

    function isSelectedStudent(portalId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/studentSessions/$(request.auth.uid))
        && get(/databases/$(database)/documents/studentSessions/$(request.auth.uid)).data.portalId == portalId
        && get(/databases/$(database)/documents/studentSessions/$(request.auth.uid)).data.regNo is string
        && get(/databases/$(database)/documents/studentPortals/$(portalId)).data.regNo is string
        && get(/databases/$(database)/documents/studentSessions/$(request.auth.uid)).data.regNo
          == get(/databases/$(database)/documents/studentPortals/$(portalId)).data.regNo;
    }

    // Shared ClassSpace interaction feed.
    match /classSpace/{postId} {
      allow read: if request.auth != null;

      // Normal students/anonymous users can create only non-admin posts.
      // Admin lookup is NOT needed for this branch.
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.isAdmin == false;

      // Only the ClassPilot owner can create highlighted admin posts.
      allow create: if request.auth != null
        && isClassAdmin()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.isAdmin == true
        && request.resource.data.authorName == "Joyal";

      allow update, delete: if isClassAdmin();

      // Legacy votes may contain portal IDs. Keep them private to the admin.
      match /votes/{portalId} {
        allow read, write: if isClassAdmin();
      }

      // Public results may contain a name only when that voter opted in.
      match /publicVotes/{voteId} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null
          && request.resource.data.keys().hasOnly(['ownerUid', 'optionIndex', 'anonymous', 'updatedAtMs', 'displayName'])
          && request.resource.data.optionIndex is int
          && request.resource.data.anonymous is bool
          && request.resource.data.updatedAtMs is int
          && ((request.resource.data.anonymous == true && !('displayName' in request.resource.data))
              || (request.resource.data.anonymous == false && request.resource.data.displayName is string))
          && (isClassAdmin() || request.resource.data.ownerUid == request.auth.uid)
          && (isClassAdmin()
              || !exists(/databases/$(database)/documents/classSpace/$(postId)/publicVotes/$(voteId))
              || resource.data.ownerUid == request.auth.uid);
        allow delete: if isClassAdmin()
          || (request.auth != null && resource.data.ownerUid == request.auth.uid);
      }

      // Private voter identity. The document key is the student portal ID,
      // allowing multiple selected students on one device to vote separately.
      match /voteIdentities/{portalId} {
        allow get: if isClassAdmin() || isSelectedStudent(portalId);
        allow list: if isClassAdmin();

        allow create, update: if isClassAdmin() || (isSelectedStudent(portalId)
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.portalId == portalId
          && request.resource.data.voteId is string
          && request.resource.data.actualName is string);

        allow delete: if isClassAdmin();
      }

      match /answers/{answerId} {
        allow read: if request.auth != null;

        // Normal student answer.
        allow create: if request.auth != null
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.isAdmin == false;

        // Highlighted admin answer.
        allow create: if request.auth != null
          && isClassAdmin()
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.isAdmin == true
          && request.resource.data.authorName == "Joyal";

        allow update: if false;
        allow delete: if isClassAdmin()
          || (request.auth != null && resource.data.ownerUid == request.auth.uid);
      }

      // Replies intentionally sent only to Joyal/Admin.
      match /adminAnswers/{answerId} {
        allow read: if isClassAdmin();
        allow create: if request.auth != null
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.isAdmin == false
          && request.resource.data.audience == "admin";
        allow update: if false;
        allow delete: if isClassAdmin()
          || (request.auth != null && resource.data.ownerUid == request.auth.uid);
      }
    }
  }
}